[sub_resource type="GDScript" id="GDScript_dyh31"]
script/source = "extends CharacterBody2D

var speed = 30

func _physics_process(delta):
	if (velocity.y > 0):
		velocity.y = velocity.y - 5
	else: if (velocity.y < 0):
		velocity.y = velocity.y + 5
	else: velocity.y = 0
	
	if Input.is_action_pressed(\"arriba\"):
		velocity.y = velocity.y - speed
	else: if Input.is_action_pressed(\"abajo\"):
		velocity.y = velocity.y + speed
	
	var collision_info = move_and_collide(velocity * delta)
	if collision_info:
		var obgeto_chocado = collision_info.get_collider()
		if obgeto_chocado.get_parent().name == \"Escenario\":
			velocity.y = 0
			
"

